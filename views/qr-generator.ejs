<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Code Generator - Barista Express</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        
        body {
            background-color: #f5f5f5;
            padding: 20px;
        }
        
        .header {
            background-color: #6f4e37;
            color: white;
            padding: 20px;
            text-align: center;
            border-radius: 10px;
            margin-bottom: 30px;
        }
        
        .container {
            max-width: 1200px;
            margin: 0 auto;
        }
        
        .controls {
            background: white;
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 30px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        
        .form-group {
            margin-bottom: 15px;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }
        
        .form-group input {
            width: 200px;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        
        .btn {
            padding: 10px 20px;
            background: #6f4e37;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            margin-right: 10px;
        }
        
        .btn:hover {
            background: #5a3e2b;
        }
        
        .qr-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
        
        .qr-card {
            background: white;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            text-align: center;
            page-break-inside: avoid;
        }
        
        .qr-card h3 {
            color: #6f4e37;
            margin-bottom: 15px;
            font-size: 1.5rem;
        }
        
        .qr-code {
            margin: 15px 0;
        }
        
        .table-url {
            font-size: 0.8rem;
            color: #666;
            word-break: break-all;
            margin-top: 10px;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 5px;
        }
        
        @media print {
            body {
                background: white;
            }
            
            .header, .controls {
                display: none;
            }
            
            .qr-card {
                box-shadow: none;
                border: 2px solid #6f4e37;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>🔲 QR Code Generator</h1>
        <p>Generate QR codes for table ordering</p>
    </div>
    
    <div class="container">
        <div class="controls">
            <div class="form-group">
                <label for="num-tables">Number of Tables:</label>
                <input type="number" id="num-tables" value="10" min="1" max="100">
            </div>
            <button class="btn" onclick="generateQRCodes()">Generate QR Codes</button>
            <button class="btn" onclick="window.print()">Print QR Codes</button>
            <a href="/dashboard" class="btn" style="display: inline-block; text-decoration: none;">Back to Dashboard</a>
        </div>
        
        <div class="qr-grid" id="qr-container">
            <!-- QR codes will be generated here -->
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.3/build/qrcode.min.js"></script>
    <script>
        const baseUrl = window.location.origin;
        
        function generateQRCodes() {
            const numTables = parseInt(document.getElementById('num-tables').value);
            const container = document.getElementById('qr-container');
            container.innerHTML = '';
            
            for (let i = 1; i <= numTables; i++) {
                const tableUrl = `${baseUrl}/?table=${i}`;
                
                const card = document.createElement('div');
                card.className = 'qr-card';
                
                const title = document.createElement('h3');
                title.textContent = `Table ${i}`;
                card.appendChild(title);
                
                const qrDiv = document.createElement('div');
                qrDiv.className = 'qr-code';
                qrDiv.id = `qr-${i}`;
                card.appendChild(qrDiv);
                
                const urlDiv = document.createElement('div');
                urlDiv.className = 'table-url';
                urlDiv.textContent = tableUrl;
                card.appendChild(urlDiv);
                
                const instructions = document.createElement('div');
                instructions.style.cssText = 'margin-top: 10px; font-size: 0.9rem; color: #666;';
                instructions.innerHTML = '📱 Scan to order';
                card.appendChild(instructions);
                
                container.appendChild(card);
                
                // Generate QR code
                QRCode.toCanvas(document.createElement('canvas'), tableUrl, {
                    width: 200,
                    margin: 2,
                    color: {
                        dark: '#6f4e37',
                        light: '#ffffff'
                    }
                }, function (error, canvas) {
                    if (error) console.error(error);
                    qrDiv.appendChild(canvas);
                });
            }
        }
        
        // Generate default 10 tables on load
        window.addEventListener('load', generateQRCodes);
    </script>
</body>
</html>